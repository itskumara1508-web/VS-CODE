# PulseX — AI Social Media Intelligence Configuration
# SIH 2026 • Problem ID 26152 • NTRO

# Optional FastAPI / AI Microservice Backend URL
# If left empty, PulseX runs seamlessly in simulated real-time mode with rich local mock data
VITE_API_URL=http://localhost:8000/api/v1

# Real-time simulation tick interval (in milliseconds)
VITE_SIMULATION_INTERVAL_MS=3500

# Default analysis time window (24H, 7D, 30D)
VITE_DEFAULT_TIME_RANGE=24H
