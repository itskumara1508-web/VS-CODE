# ============================================================
# NTRO Social Intelligence - Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.
# ============================================================

# ---------- MOCK DATA MODE ----------
# When true, the system runs entirely on generated synthetic data
# and does NOT require any social media API credentials.
MOCK_DATA_MODE=true

# ---------- API SERVICE ----------
API_PORT=4000
API_HOST=0.0.0.0
API_LOG_LEVEL=info

# ---------- JWT / AUTH ----------
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=8h
TOKEN_ISSUER=ntro-social-intelligence

# ---------- DATABASE (PostgreSQL / TimescaleDB) ----------
DATABASE_URL=postgres://ntro:ntro@localhost:5432/ntro_social_intelligence
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=ntro
DATABASE_PASSWORD=ntro
DATABASE_NAME=ntro_social_intelligence
DATABASE_SSL=false

# ---------- GRAPH DATABASE (Neo4j) ----------
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ntro-social-intelligence

# ---------- REDIS ----------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- AI SERVICE ----------
AI_SERVICE_URL=http://localhost:5001
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5001
AI_MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment-latest
AI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- WEBSOCKET / REAL-TIME ----------
WS_PATH=/ws
WS_PORT=8080

# ---------- FIREBASE ----------
# Firebase Cloud Messaging (optional). Leave blank to disable push.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ---------- PLATFORM API CREDENTIALS (leave blank in mock mode) ----------
# X (Twitter) - never commit real credentials
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# Telegram - never commit real credentials
TELEGRAM_BOT_TOKEN=

# Instagram - never commit real credentials
INSTAGRAM_ACCESS_TOKEN=

# Facebook - never commit real credentials
FACEBOOK_ACCESS_TOKEN=

# Reddit - never commit real credentials
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ntro-social-intelligence/1.0

# YouTube - never commit real credentials
YOUTUBE_API_KEY=

# ---------- RATE LIMITING ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---------- SECURITY ----------
CORS_ORIGIN=http://localhost:3000
BCRYPT_ROUNDS=10
